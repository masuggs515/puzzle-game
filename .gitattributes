# Normalise all text files to LF in the repo, regardless of platform autocrlf settings
* text=auto eol=lf

# Explicitly mark shell scripts as text with LF
*.sh text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar.gz binary
*.apk binary
*.ipa binary
*.aab binary
